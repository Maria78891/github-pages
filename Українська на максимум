<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Українська мова на максимум!</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f8f9fa;
            text-align: center;
        }
        header {
            background: linear-gradient(90deg, #ff6a00, #ff4500);
            color: white;
            padding: 50px 20px;
        }
        .btn {
            display: inline-block;
            padding: 15px 30px;
            background: #ffcc00;
            color: black;
            text-decoration: none;
            font-weight: bold;
            border-radius: 10px;
            transition: 0.3s;
        }
        .btn:hover {
            background: #ffdb4d;
        }
        section {
            padding: 40px 20px;
        }
        ul, ol {
            text-align: left;
            display: inline-block;
        }
        #register form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 400px;
            margin: 0 auto;
        }
        input, button {
            padding: 10px;
            font-size: 16px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        button {
            background: #ff6a00;
            color: white;
            border: none;
            cursor: pointer;
            transition: 0.3s;
        }
        button:hover {
            background: #ff4500;
        }
        .social {
            margin-top: 20px;
        }
        footer {
            background: #333;
            color: white;
            padding: 20px;
            margin-top: 30px;
        }
        .illustration {
            max-width: 100%;
            height: auto;
            margin: 20px 0;
            border-radius: 10px;
        }
    </style>
</head>
